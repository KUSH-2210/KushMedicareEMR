# Project API URL from Supabase Settings > API (HTTPS). Do not use a PostgreSQL connection string.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Browser-safe publishable key. Never use sb_secret_, service_role, or a database password here.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
